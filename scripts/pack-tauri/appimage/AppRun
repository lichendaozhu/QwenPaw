#!/usr/bin/env sh

set -eu

APPDIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
export LD_LIBRARY_PATH="$APPDIR/usr/lib:$APPDIR/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH:-}"

# Run with the loader and glibc shipped in the AppImage. This is what makes
# the Ubuntu 22.04 Tauri/WebKit build usable on Kylin systems with glibc 2.31.
LOADER="$APPDIR/usr/lib/ld-linux-x86-64.so.2"
if [ -x "$LOADER" ]; then
  exec "$LOADER" --library-path "$LD_LIBRARY_PATH" "$APPDIR/usr/bin/qwenpaw-desktop" "$@"
fi
exec "$APPDIR/usr/bin/qwenpaw-desktop" "$@"
