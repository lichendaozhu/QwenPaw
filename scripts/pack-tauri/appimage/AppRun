#!/usr/bin/env sh

set -eu

APPDIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

case "$(uname -m)" in
  x86_64|amd64)
    GNU_TRIPLET="x86_64-linux-gnu"
    GLIBC_LOADER="ld-linux-x86-64.so.2"
    ;;
  aarch64|arm64)
    GNU_TRIPLET="aarch64-linux-gnu"
    GLIBC_LOADER="ld-linux-aarch64.so.1"
    ;;
  *)
    echo "QwenPaw does not support this architecture: $(uname -m)" >&2
    exit 1
    ;;
esac

export LD_LIBRARY_PATH="$APPDIR/usr/lib:$APPDIR/usr/lib/$GNU_TRIPLET:${LD_LIBRARY_PATH:-}"
# Kylin V10's system Wayland stack is older than the GTK/WebKit build used by
# QwenPaw. Prefer the X11 backend on desktop sessions; the matching Wayland
# libraries are bundled as well for GTK's dependency resolution.
export GDK_BACKEND="${GDK_BACKEND:-x11}"

# Run with the loader and glibc shipped in the AppImage. This is what makes
# the Ubuntu 22.04 Tauri/WebKit build usable on Kylin systems with glibc 2.31.
LOADER="$APPDIR/usr/lib/$GLIBC_LOADER"
if [ -x "$LOADER" ]; then
  if [ "$GNU_TRIPLET" = "aarch64-linux-gnu" ] && [ -x "$APPDIR/usr/bin/patchelf" ]; then
    # Calling ld-linux-aarch64.so.1 directly loses the ARM auxiliary vector
    # used by GLib's getauxval(). Use the bundled loader as the ELF interpreter
    # instead, which preserves the normal kernel process startup path.
    PATCHED_BIN="${TMPDIR:-/tmp}/qwenpaw-desktop-$$"
    cp "$APPDIR/usr/bin/qwenpaw-desktop" "$PATCHED_BIN"
    "$LOADER" --library-path "$LD_LIBRARY_PATH" "$APPDIR/usr/bin/patchelf" \
      --set-interpreter "$LOADER" "$PATCHED_BIN"
    chmod +x "$PATCHED_BIN"
    exec "$PATCHED_BIN" "$@"
  fi
  exec "$LOADER" --library-path "$LD_LIBRARY_PATH" "$APPDIR/usr/bin/qwenpaw-desktop" "$@"
fi
exec "$APPDIR/usr/bin/qwenpaw-desktop" "$@"
